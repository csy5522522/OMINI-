# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*

# Python virtual environments
.venv/
venv/

# PyInstaller build products
/build/
/dist/
/build-*/
/dist-*/
/artifacts/
/local-data/
/gallery-dl.spec
/spotdl.spec

# Embedded frontend dependencies
node_modules/

# Logs and temporary files
*.log
logs/
log/
tmp/
temp/
.cache/
*.tmp
*.temp

# Local environment settings
.env
.env.*
!.env.example
/deploy/secrets/
*.sqlite3
*.sqlite3-*
account-sync.key
*.account-sync.key
memo-storage.key
*.memo-storage.key
*.sqlite3.key
*.ominote
.memo-migration-*
.migration-backup/
**/account-workspaces/
*.sql.gz

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Downloaded third-party executables (distributed with Release installers)
/tools/*.exe
/tools/*.dll

# Omini API personal data stays outside version control and release sources
**/accounts/
**/xhhai_*account*.json
**/xhhai_*state*.json
**/omini_api_toolbox_settings.json
**/omini_email_receiver.json
**/omini_sites.json
**/omini_site_discovery.jsonl
*.har

# Assistant runtime credentials and dedicated Codex sessions belong in AppData.
**/ai-assistants/auths/
**/ai-assistants/codex-pool/
**/ai-assistants/settings.json
**/ai-assistants/settings.json.bak
**/ai-assistants/state.json
**/ai-assistants/state.json.bak
**/ai-assistants/history/
**/ai-assistants/backups/
**/ai-assistants/recovery/
